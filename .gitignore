# Root .gitignore for project-manager

# Environment variables
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Dependencies
node_modules/
vendor/
backend/vendor/
frontend/node_modules/

# Build and caches
dist/
build/
frontend/dist/
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/storage/pail
backend/public/storage
backend/public/build
backend/public/hot
.phpunit.cache
.phpunit.result.cache

# Operating System
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
